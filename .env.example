# Токен сообщества ВКонтакте
# Настройки → Работа с API → Ключи доступа → Создать ключ
# Необходимые права: messages
VK_TOKEN=your_community_token_here

# Таймаут сессии в секундах (по умолчанию 600 = 10 минут)
SESSION_TIMEOUT=600

# Пути к файлам (можно не менять)
DB_PATH=quiz.db
KEY_PATH=secret.key
